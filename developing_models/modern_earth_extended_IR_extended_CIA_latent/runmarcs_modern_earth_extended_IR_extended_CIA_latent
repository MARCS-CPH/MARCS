#!/bin/bash
#SBATCH --job-name=exp_earth_extIR_extCIA_latent
#SBATCH --time=8:00:00
#SBATCH --partition=astro2_short
#SBATCH --nodes=1
#SBATCH --mem-per-cpu=30G
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mail-type=NONE

# Isolated LATENT=1 test (VIRGA=1 LATENT=1), extended IR + 6-pair CIA.
# Generic inputs come from data/; input_files/ has only the restart
# archive + stellar spectrum.

module load astro gdb python/mamba/2023
MAIN=/lustre/hpc/astro/tbalduin/MARCS_CPH/MARCS
CWD=$MAIN
TMPDIR=$(mktemp -p /dev/shm/ -u)

model_dir=$MAIN/developing_models/modern_earth_extended_IR_extended_CIA_latent
in_dir=${model_dir}/input_files/
out_dir=${model_dir}/output/

in_filename=${in_dir}marcs_output

mkdir -p ${out_dir}
mkdir $TMPDIR
mkdir $TMPDIR/data/

input_parameters=${model_dir}/marcs_modern_earth_extended_IR_extended_CIA_latent.input
input_elabund=$CWD/data/elabund_earth_modern.dat
input_opac=$CWD/data/mol_names_cool_75.dat
input_spectrum=${in_dir}stellar_spectrum_solar_modern_16937.dat
input_jonabs=$CWD/data/jonabs.dat
input_abundance=$CWD/data/krome_init_abund_earth_modern_N2O2CO2CH4.dat
input_cia=$CWD/data/cia_pairs_earth_6pair.dat

cp $input_parameters  $TMPDIR/mxms7.input
cp $input_elabund $TMPDIR/data/elabund.dat
cp $input_opac $TMPDIR/data/mol_names.dat
cp $input_spectrum $TMPDIR/data/stellar_spectrum.dat
cp $input_jonabs $TMPDIR/data/jonabs.dat
cp $input_abundance $TMPDIR/data/krome_init_abund.dat
cp $input_cia $TMPDIR/data/cia_list.dat

cp ${in_filename}.arciv $TMPDIR/arcivaaa.dat

cp ${in_dir}marcs2ggchem.in $TMPDIR/marcs2ggchem_template.in
cp $CWD/GGchem/marcs2gg_partpp.dat $TMPDIR
cp -r $CWD/data/abinit_abmarcs.dat $TMPDIR/data
cp -r $CWD/data/dispol_* $TMPDIR/data
cp -r $CWD/data/DustChem* $TMPDIR/data
cp -r $CWD/data/nasa9.dat $TMPDIR/data

cp $CWD/*.inc $TMPDIR/
cp $CWD/*.dat $TMPDIR/
cp $CWD/marcs_earth_wnos1_clean $TMPDIR/marcs_earth_wnos1_clean

cp $CWD/krome/build_earth_wnos1/*.dat $TMPDIR/
cp -r $CWD/krome/ $TMPDIR/
cp $TMPDIR/krome/build_earth_wnos1/info.log $TMPDIR/krome/MARCS_build/info.log
cp -r $CWD/GGchem $TMPDIR/

cp $CWD/virga/virga_condensates.dat $TMPDIR/
cp $CWD/virga/virga_condensate_stoich.dat $TMPDIR/
cp $CWD/virga/call_virga.py $TMPDIR/
cp $CWD/virga/virga2marcs_script.py $TMPDIR/

cd $TMPDIR

cp $input_parameters ${out_dir}
cp $input_elabund ${out_dir}
cp $input_jonabs ${out_dir}
cp $input_opac ${out_dir}
cp $input_spectrum ${out_dir}
cp $input_cia ${out_dir}

./marcs_earth_wnos1_clean
MARCS_EXIT=$?
echo "marcs exited with status $MARCS_EXIT"

if [ -f arcivaab.dat ]; then cp arcivaab.dat  ${out_dir}/marcs_output.arciv; fi
if [ -f mxmodel.dat ]; then cp mxmodel.dat    ${out_dir}/marcs_output.dat; fi
if [ -f full_output.dat ]; then cp full_output.dat ${out_dir}; fi
if [ -f krome_final_output.dat ]; then cp krome_final_output.dat ${out_dir}; fi
if [ -f ffl_diag.dat ]; then cp ffl_diag.dat ${out_dir}; fi
if [ -f latent_thermo_diag.dat ]; then cp latent_thermo_diag.dat ${out_dir}; fi
if [ -f sedflux_diag.dat ]; then cp sedflux_diag.dat ${out_dir}; fi
if [ -f marcs2virga.dat ]; then cp marcs2virga.dat ${out_dir}; fi
if [ -f virga_particle_props.dat ]; then cp virga_particle_props.dat ${out_dir}; fi
cp $CWD/slurm-$SLURM_JOB_ID.out ${out_dir} 2>/dev/null

rm -rf $TMPDIR
exit $MARCS_EXIT

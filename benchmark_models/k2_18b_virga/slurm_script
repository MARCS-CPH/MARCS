#!/bin/bash
#SBATCH --job-name=K2_18bVirga
#SBATCH --time=2:00:00
#SBATCH --partition=astro2_short
#SBATCH --nodes=1
#SBATCH --mem-per-cpu=30G
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mail-type=ALL

module load astro gdb python/mamba/2023
### INPUT AND TEMP FOLDERS ###
CWD=$(pwd)
TMPDIR=$(mktemp -p /dev/shm/ -u)

# Full-physics virga benchmark: VIRGA=1, CNDNSA=1, CLOUDS=1, LATENT=1
# (single H2O condensate). Restarts from k2_18b_planet's own converged
# archive, same equilibrium-chemistry (NONEQ=0) base case, so the only
# difference from that benchmark is the cloud microphysics coupling.
in_dir=./benchmark_models/k2_18b_virga/
out_dir=./benchmark_models/k2_18b_virga/output/

in_filename=${in_dir}marcs_output
out_filename=${out_dir}marcs_output

data_folder=/data/

mkdir -p ${out_dir}
cp "$0" $CWD/${out_dir}
mkdir $TMPDIR
mkdir $TMPDIR/data/

input_parameters=${in_dir}marcs_k2_18b_virga.input
input_elabund=$CWD${data_folder}elabund_K2_18b.dat
input_opac=$CWD${data_folder}mol_names_72_O2O3_2026_combined.dat
input_spectrum=$CWD${data_folder}stellar_spectrum_K2_18_7949.dat
input_jonabs=$CWD${data_folder}jonabs.dat

### COPY INPUT FILES INTO TMP FOLDER ###
cp $input_parameters  $TMPDIR/mxms7.input
cp $input_elabund $TMPDIR/data/elabund.dat
cp $input_opac $TMPDIR/data/mol_names.dat
cp $input_spectrum $TMPDIR/data/stellar_spectrum.dat
cp $input_jonabs $TMPDIR/data/jonabs.dat

# read-only: never writes back into in_dir
cp ${in_filename}.arciv $TMPDIR/arcivaaa.dat

cp $CWD/GGchem/marcs2gg_partpp.dat $TMPDIR
cp $CWD/GGchem/marcs2ggchem_template.in $TMPDIR
cp -r data/abinit_abmarcs.dat $TMPDIR/data
cp -r data/dispol_* $TMPDIR/data
cp -r data/DustChem* $TMPDIR/data
cp -r data/nasa9.dat $TMPDIR/data

cp *.inc $TMPDIR/
cp *.dat $TMPDIR/
cp marcs $TMPDIR/marcs

# VIRGA=1 staging
cp $CWD/virga/virga_condensates.dat $TMPDIR/
cp $CWD/virga/virga_condensate_stoich.dat $TMPDIR/
cp $CWD/virga/call_virga.py $TMPDIR/
cp $CWD/virga/virga2marcs_script.py $TMPDIR/

cp $CWD/krome/MARCS_build/*.dat $TMPDIR/
cp -r $CWD/krome/ $TMPDIR/
cp -r GGchem $TMPDIR/
cd $TMPDIR

### COPY INPUTFILES BEFORE RUN ###
cp $input_parameters $CWD/${out_dir}
cp $input_elabund $CWD/${out_dir}
cp $input_jonabs $CWD/${out_dir}
cp $input_opac $CWD/${out_dir}
cp $input_spectrum $CWD/${out_dir}

./marcs
MARCS_EXIT=$?

### COPY FILES AFTER RUN -- all into out_dir, never back into in_dir ###
if [ -f arcivaab.dat ]; then cp arcivaab.dat  $CWD/${out_filename}.arciv; fi
if [ -f mxmodel.dat ]; then cp mxmodel.dat    $CWD/${out_filename}.dat; fi
if [ -f full_output.dat ]; then cp full_output.dat $CWD/${out_dir}; fi
if [ -f marcs2ggchem.in ]; then cp marcs2ggchem.in $CWD/${out_dir}; fi
if [ -f ggchem_out.txt ]; then cp ggchem_out.txt $CWD/${out_dir}; fi

### VIRGA/CNDNSA/CLOUDS/LATENT diagnostics ###
if [ -f marcs2virga.dat ]; then cp marcs2virga.dat $CWD/${out_dir}; fi
if [ -f virga2marcs.dat ]; then cp virga2marcs.dat $CWD/${out_dir}; fi
if [ -f virga2marcs_mmr.dat ]; then cp virga2marcs_mmr.dat $CWD/${out_dir}; fi
if [ -f virga2marcs_sedflux.dat ]; then cp virga2marcs_sedflux.dat $CWD/${out_dir}; fi
if [ -f virga_particle_props.dat ]; then cp virga_particle_props.dat $CWD/${out_dir}; fi
if [ -f cndnsa_diag.dat ]; then cp cndnsa_diag.dat $CWD/${out_dir}; fi
if [ -f latent_thermo_diag.dat ]; then cp latent_thermo_diag.dat $CWD/${out_dir}; fi
if [ -f sedflux_diag.dat ]; then cp sedflux_diag.dat $CWD/${out_dir}; fi
if [ -f ffl_diag.dat ]; then cp ffl_diag.dat $CWD/${out_dir}; fi
if [ -f KROME_ERROR_REPORT ]; then cp KROME_ERROR_REPORT $CWD/${out_dir}; fi
cp $CWD/slurm-$SLURM_JOB_ID.out $CWD/${out_dir} 2>/dev/null

rm -rf $TMPDIR

echo "marcs exited with status $MARCS_EXIT"
exit $MARCS_EXIT

#!/bin/bash
# SLURM resource specifications
# (use an extra ‘#’ in front of SBATCH to comment-out any unused options)
#SBATCH --job-name=marcs_build # shows up in the output of ‘squeue’
#SBATCH --time=4:00:00       # specify the requested wall-time
#SBATCH --partition=astro2_short   # specify the partition to run on
#SBATCH --nodes=1              # number of nodes allocated for this job
#SBATCH --mem-per-cpu=30G
#SBATCH --ntasks-per-node=1    # number of MPI ranks per node
#SBATCH --cpus-per-task=1       # number of OpenMP threads per MPI rank
#SBATCH --mail-type=ALL

# Builds the default marcs/krome/MARCS_build target. To build a different
# KROME network, pass overrides as sbatch args, e.g.:
#   sbatch compile_marcs_SLURM KROME_BUILD=krome/build_v6_DMS EXEC=marcs_v6_DMS
make "$@"

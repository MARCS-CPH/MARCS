#!/bin/bash
#SBATCH --job-name=K2_18bPlanet
#SBATCH --time=1:00:00
#SBATCH --partition=astro2_short
#SBATCH --nodes=1
#SBATCH --mem-per-cpu=30G
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mail-type=ALL

module load astro gdb
### INPUT AND TEMP FOLDERS ###
CWD=$(pwd)
TMPDIR=$(mktemp -p /dev/shm/ -u)

# 2026-08-29: switched the k2_18b_planet benchmark from the non-eq
# (KROME) DMS-earthbiomass setup to an equilibrium-chemistry-only
# (NONEQ=0) model, restarting cleanly and converging in 5 iterations
# under the current code. The previous non-eq deck never converged
# reliably (an unresolved oscillation at its deepest layer); this one
# uses SURFAC=0 specifically -- SURFAC=1 (rigid bottom-boundary
# temperature anchor) was found to destabilize the adjacent layer under
# the current SOLVE code, while SURFAC=0 settles cleanly (see
# K2_18b_Irr_spec_ocean_eq_surfac0_verify test, 2026-08-29). No CIA
# (LINCIA=0) and no KROME involved (NONEQ=0), so no krome_init_abund or
# cia_pairs file is needed.
in_dir=./benchmark_models/k2_18b_planet/
out_dir=./benchmark_models/k2_18b_planet/output/

in_filename=${in_dir}marcs_output
out_filename=${out_dir}marcs_output

input_folder=/input_files/
data_folder=/data/

mkdir -p ${out_dir}
cp "$0" $CWD/${out_dir}
mkdir $TMPDIR
mkdir $TMPDIR/data/

input_parameters=$CWD${input_folder}marcs_k2_18b_planet.input
input_elabund=$CWD${data_folder}elabund_K2_18b.dat
input_opac=$CWD${data_folder}mol_names_72_O2O3_2026_combined.dat
input_spectrum=$CWD${data_folder}stellar_spectrum_K2_18_7949.dat
input_jonabs=$CWD${data_folder}jonabs.dat

### COPY INPUT FILES INTO TMP FOLDER ###
cp $input_parameters  $TMPDIR/mxms7.input
cp $input_elabund $TMPDIR/data/elabund.dat
cp $input_opac $TMPDIR/data/mol_names.dat
cp $input_spectrum $TMPDIR/data/stellar_spectrum.dat
cp $input_jonabs $TMPDIR/data/jonabs.dat

cp ${in_filename}.arciv $TMPDIR/arcivaaa.dat

cp $CWD/GGchem/marcs2gg_partpp.dat $TMPDIR
cp $CWD/GGchem/marcs2ggchem_template.in $TMPDIR
cp -r data/abinit_abmarcs.dat $TMPDIR/data
cp -r data/dispol_* $TMPDIR/data
cp -r data/DustChem* $TMPDIR/data
cp -r data/nasa9.dat $TMPDIR/data

cp *.inc $TMPDIR/
cp *.dat $TMPDIR/
cp marcs $TMPDIR/marcs

cp $CWD/krome/MARCS_build/*.dat $TMPDIR/
cp -r $CWD/krome/ $TMPDIR/
cp -r GGchem $TMPDIR/
cd $TMPDIR

### COPY INPUTFILES BEFORE RUN ###

cp $input_parameters $CWD/${out_dir}
cp $input_elabund $CWD/${out_dir}
cp $input_jonabs $CWD/${out_dir}
cp $input_opac $CWD/${out_dir}
cp $input_spectrum $CWD/${out_dir}

./marcs
MARCS_EXIT=$?

### COPY FILES AFTER RUN ###

if [ -f arcivaab.dat ]; then cp arcivaab.dat  $CWD/${out_filename}.arciv; fi
if [ -f mxmodel.dat ]; then cp mxmodel.dat    $CWD/${out_filename}.dat; fi
if [ -f $TMPDIR/marcs2ggchem.in ]; then cp $TMPDIR/marcs2ggchem.in $CWD/${out_dir}/marcs2ggchem.in; fi
if [ -f $TMPDIR/ggchem_out.txt ]; then cp $TMPDIR/ggchem_out.txt $CWD/${out_dir}/ggchem_out.txt; fi
cp $CWD/slurm-$SLURM_JOB_ID.out $CWD/${out_dir} 2>/dev/null
if [ -f $TMPDIR/spectrum.dat ]; then cp $TMPDIR/spectrum.dat $CWD/${out_dir}; fi
if [ -f "$TMPDIR/full_output.dat" ]; then cp $TMPDIR/full_output.dat $CWD/${out_dir}/full_output.dat; fi

rm -rf $TMPDIR

echo "marcs exited with status $MARCS_EXIT"
exit $MARCS_EXIT

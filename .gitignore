# --- Build artifacts ---
*.o
*.mod
*.pyc
__pycache__/
*.log

# --- Compiled MARCS binaries (top level) ---
# Every build variant is a bare extensionless executable (marcs, marcs_v2,
# marcs_stand, marcs_v6_DMS, ...). Ignore anything matching that shape
# instead of hand-listing each variant, but keep source (*.f, *.bak, *.dat,
# *.in, ...) and the marcs_versions/ directory visible.
/marcs*
!/marcs*/
!/marcs*.*

# --- KROME build output ---
krome/build_*/
krome/builds/
krome/MARCS_build*/

# --- Run output ---
/models/

# --- Benchmark models: track the reference input/output in each
# benchmark_models/<name>/ dir, but never the output/ subdir a run writes
# fresh results into -- keeps a run from ever silently overwriting the
# tracked reference via a plain commit/add.
/benchmark_models/*/output/

# --- SLURM job logs ---
slurm-*.out

# --- Runtime staging droppings (left in-tree instead of $TMPDIR) ---
/GGchem_ppel
/KROME_ERROR_REPORT
/ggchem_out.txt
/mxmodel.dat
/pp.dat
/ndensity*.dat
/mol_names.dat
/elabund.dat
/mxms7.input
/queue.txt
